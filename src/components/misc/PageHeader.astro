---
/**
 * 内容页统一的标题卡片（Others 里的 4 个页面共用）。
 * 结构：大标题 + 主题色小圆点 + 一句说明，外面套上站点统一的卡片样式。
 */
import { Icon } from "astro-icon/components";

interface Props {
	/** 页面标题 */
	title: string;
	/** 标题左边的图标，Iconify 名称 */
	icon?: string;
	/** 标题下面的一句话说明 */
	description?: string;
}

const { title, icon, description } = Astro.props;
---

<div class="card-base px-6 py-6 md:px-9 md:py-7 mb-4">
    <div class="flex items-center gap-3">
        {icon && (
            <div class="w-11 h-11 rounded-xl flex items-center justify-center bg-[var(--btn-regular-bg)] shrink-0 transition">
                <Icon name={icon} class="text-[var(--primary)] text-[1.5rem]" />
            </div>
        )}
        <div class="min-w-0">
            <h1 class="text-2xl md:text-3xl font-bold text-neutral-900 dark:text-neutral-100 transition m-0">
                {title}
            </h1>
            <div class="h-1 w-8 bg-[var(--primary)] rounded-full mt-2 transition"></div>
        </div>
    </div>
    {description && (
        <p class="mt-3 mb-0 text-neutral-500 dark:text-neutral-400 text-sm transition">
            {description}
        </p>
    )}
</div>
