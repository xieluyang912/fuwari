---
/**
 * 横幅底部的波浪分隔（对齐 Mizuki 参考站的效果）。
 *
 * 实现原理（照搬 Mizuki）：
 * 一条 SVG 路径 #gentle-wave 用 4 个 <use> 复用了 4 次，
 * 每层 y 偏移不同（0/3/5/7）、不透明度不同（0.25/0.5/0.75/1）、
 * 动画时长不同（7s/10s/13s/20s），叠在一起就有了「多层水波错位流动」的视差感。
 *
 * 关键在于波浪的填充色是 var(--page-bg)，也就是页面底色 ——
 * 看起来就像页面背景从下面漫上来把横幅「切」掉了，
 * 所以换主题色 / 切深浅色时波浪会自动跟着变色。
 */
---

<div
    class="waves absolute -bottom-px h-[8vh] min-h-[60px] max-h-[80px] w-full
           min-[480px]:h-[10vh] min-[480px]:min-h-[70px] min-[480px]:max-h-[100px]
           md:h-[12vh] md:min-h-[80px] md:max-h-[120px]
           xl:h-[15vh] xl:min-h-[80px] xl:max-h-[150px]"
    id="header-waves"
>
    <svg
        class="waves"
        xmlns="http://www.w3.org/2000/svg"
        xmlns:xlink="http://www.w3.org/1999/xlink"
        viewBox="0 20 150 32"
        preserveAspectRatio="none"
        shape-rendering="auto"
    >
        <defs>
            <path
                id="gentle-wave"
                d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v48h-352z"
            ></path>
        </defs>
        <g class="parallax">
            <use xlink:href="#gentle-wave" x="48" y="0" class="wave-layer opacity-25" style="animation-delay: -2s; animation-duration: 7s;"></use>
            <use xlink:href="#gentle-wave" x="48" y="3" class="wave-layer opacity-50" style="animation-delay: -3s; animation-duration: 10s;"></use>
            <use xlink:href="#gentle-wave" x="48" y="5" class="wave-layer opacity-75" style="animation-delay: -4s; animation-duration: 13s;"></use>
            <use xlink:href="#gentle-wave" x="48" y="7" class="wave-layer" style="animation-delay: -5s; animation-duration: 20s;"></use>
        </g>
    </svg>
</div>

<style>
    .waves {
        /* 横向平铺，避免波浪左右移动时露出空白 */
        width: 100%;
        height: 100%;
        display: block;
    }

    .wave-layer {
        fill: var(--page-bg);
        will-change: transform;
        backface-visibility: hidden;
        /* 时长由内联 style 覆盖，这里只定缓动与循环 */
        animation-name: wave-move;
        animation-timing-function: cubic-bezier(0.5, 0.5, 0.45, 0.5);
        animation-iteration-count: infinite;
    }

    /* 左右来回平移，因为路径本身比画布宽，所以看不出接缝 */
    @keyframes wave-move {
        0% {
            transform: translate(-90px, 0);
        }
        100% {
            transform: translate(85px, 0);
        }
    }

    /* 尊重系统的「减少动态效果」设置 */
    @media (prefers-reduced-motion: reduce) {
        .wave-layer {
            animation: none;
        }
    }
</style>
